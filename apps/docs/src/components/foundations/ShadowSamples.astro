---
import tokens from '../../generated/tokens.json';

/**
 * Every `shadow-ws-*` and `drop-shadow-ws-*` class on a light and a dark panel, side by side.
 * Samples paint with what the class applies. The light panel re-states the light
 * `--ws-elevation-*` values (read from shadow.css), because on a dark page `.dark` on the root
 * has already switched them; the dark panel gets the library's own `.dark` class.
 */
// `var(--x, #fff)` → `var(--x)`: the fallbacks never apply (both themes declare the variable),
// and keeping them would put raw colours in the markup.
const noFallback = (value: string) => value.replace(/var\((--[\w-]+),[^()]*\)/g, 'var($1)');
const lightScope = tokens.shadows
  .filter((shadow) => shadow.variable)
  .map((shadow) => `${shadow.variable}: ${noFallback(shadow.light)}`)
  .join('; ');
const paint = (shadow: (typeof tokens.shadows)[number]) =>
  `${shadow.kind === 'drop' ? 'filter' : 'box-shadow'}: ${noFallback(shadow.paint)}`;
const panels = [
  { label: 'Light', className: 'docs-light', style: lightScope },
  { label: 'Dark', className: 'dark', style: '' },
];
---

<div class="not-prose mt-4 flex flex-col gap-3">
  {tokens.shadows.map((shadow) => (
    <div class="border-ws-static-subtle rounded-[12px] border">
      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 px-4 pt-3">
        <code class="text-ws-static-strong font-mono text-[13px]">{shadow.className}</code>
        {shadow.variable && (
          <code class="text-ws-static-subtle font-mono text-[12px]">{shadow.variable}</code>
        )}
        <span class="text-ws-static-subtle text-[12px]">
          {shadow.usedBy.length > 0
            ? `Used by ${shadow.usedBy.join(', ')}`
            : 'Not used by a component'}
        </span>
      </div>
      <div class="grid grid-cols-1 gap-3 p-4 sm:grid-cols-2">
        {panels.map((panel) => (
          <div
            class:list={[
              panel.className,
              'bg-ws-static-background flex flex-col gap-3 rounded-[8px] px-6 pt-6 pb-3',
            ]}
            style={panel.style}
          >
            <div
              class:list={[
                'bg-ws-static-container h-14 rounded-[8px]',
                shadow.kind === 'drop' && 'mx-auto w-2/3',
              ]}
              style={paint(shadow)}
            />
            <div class="text-ws-static-subtle flex justify-between gap-3 text-[11px] leading-4">
              <span>{panel.label}</span>
              {panel.label === 'Dark' && !shadow.dark && shadow.variable === null && (
                <span>colours follow the theme</span>
              )}
              {panel.label === 'Dark' && shadow.dark && (
                <span class="min-w-0 truncate font-mono" title={shadow.dark}>
                  {shadow.dark}
                </span>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  ))}
</div>
