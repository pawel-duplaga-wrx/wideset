---
import tokens from '../../generated/tokens.json';

/**
 * The primitive colour ramps, one row per family. Swatches paint with the token itself, so a
 * project that overrides a primitive sees its own value here.
 */
---

<div class="not-prose mt-6 flex flex-col gap-5">
  {tokens.palette.map((ramp) => (
    <div>
      <div class="text-ws-static-strong mb-2 text-[13px] leading-5 font-medium capitalize">
        {ramp.family}
      </div>
      <div class="grid grid-cols-6 gap-1 sm:grid-cols-12">
        {ramp.steps.map((swatch) => (
          <div class="min-w-0" title={swatch.name}>
            <div
              class="border-ws-static-subtle h-10 rounded-[6px] border"
              style={`background: var(${swatch.name})`}
            />
            <div class="text-ws-static-subtle mt-1 text-[11px] leading-4">{swatch.step}</div>
          </div>
        ))}
      </div>
    </div>
  ))}
</div>
